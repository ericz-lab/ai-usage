<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd agent (no sudo). deploy/install.sh installs it as
     ~/Library/LaunchAgents/ai-usage.plist with @DIR@ and @BUN@ replaced. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai-usage</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BUN@</string>
    <string>src/index.ts</string>
  </array>
  <key>WorkingDirectory</key><string>@DIR@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@DIR@/data/ai-usage.log</string>
  <key>StandardErrorPath</key><string>@DIR@/data/ai-usage.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
