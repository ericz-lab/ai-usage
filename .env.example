# Every variable the service reads. Real values go in .env (ignored) or in the
# space.env ai-space writes; nothing here is required.

# Port to bind on 127.0.0.1. ai-space hands PORT over from space.yaml.
# PORT=8880

# Where the SQLite cache lives. ai-space sets DATABASE_URL (sqlite:///path) and
# SPACE_APP_DATA_DIR; without either the file is data/usage.db.
# DATABASE_URL=sqlite:///home/me/.ai-space/data/ai-usage/main.db

# Transcript directories, comma-separated, scanned recursively for *.jsonl.
# Default: ~/.claude/projects and the Xcode Claude integration directory.
# USAGE_SOURCES=~/.claude/projects,/mnt/other-box/.claude/projects

# Seconds between background scans (default 300). Reads also trigger a scan
# when the last one is older than a minute.
# USAGE_SCAN_INTERVAL=300

# Seconds between shared-store syncs (publish this machine's rows, pull the
# others'); default 1800. The Refresh button syncs at once.
# USAGE_SYNC_INTERVAL=1800

# The shared store. Inside ai-space these come from space.env (storage.blobs: s3
# in space.yaml); a standalone machine (a laptop) sets them here to join the
# same bucket. A file:// BLOB_URL or none = this machine stays local.
# BLOB_URL=s3://<bucket>/ai-usage/
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# This machine's name on every dashboard (and its directory in the shared
# store): letters, digits, . _ -. Default: SPACE_NAME, else the hostname.
# USAGE_MACHINE=laptop

# Fallback when there is no shared store: other ai-usage instances reachable
# directly, name=url,... (an ssh tunnel, a LAN).
# USAGE_PEERS=
