{
  "name": "ai-usage",
  "version": "0.1.0",
  "description": "AI usage dashboard for one machine: what Claude Code spent, read from its own transcripts. An ai-space app.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "scan": "bun src/index.ts scan",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun install && bun run typecheck && bun test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.0"
  }
}
